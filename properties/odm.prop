# Audio
ro.config.media_vol_steps=30
ro.config.vc_call_vol_steps=9
ro.oplus.image.my_engineering.type=release
ro.vendor.qti.va_odm.support=1
sys.oplus_ftm_mode=997

# Bluetooth
persist.vendor.bluetooth.modem_nv_support=true

# Camera
ro.hardware.camera=oemlayer

# Radio
persist.vendor.radio.force_on_dc=true
persist.vendor.radio.mdccbsize=164
persist.vendor.radio.virtualcomm=1
ro.sys.reserve.integrate=true
ro.vendor.oplus.radio.project=1
ro.vendor.oplus.radio.sar_regionmark=FCC

# SVN
ro.build.version.svn=56

# Overrides for values the QTI display component also sets in vendor
persist.sys.sf.color_mode=0
vendor.display.disable_hw_recovery_dump=1
vendor.display.enable_hdr10_gpu_target=0
debug.graphics.game_default_frame_rate.disabled=0
debug.sf.disable_client_composition_cache=1
debug.sf.enable_gl_backpressure=0
